@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

### On crée un lieu complet, avec tous les champs
# @name createPlace
POST {{baseUrl}}/places
Content-Type: {{contentType}}

{
  "name": "Bibliothèque Centrale",
  "description": "Grand espace de travail calme avec accès Wi-Fi haut débit et prises partout.",
  "category": "LIBRARY",
  "address": "1234 Rue de l'Université, Montréal",
  "services": ["Wi-Fi", "Prises électriques", "Imprimante", "Salles d'étude"],
  "status": "ACTIVE"
}

###
@createdPlaceId = {{createPlace.response.body.id}}

### Un lieu valide, mais sans les champs optionnels
POST {{baseUrl}}/places
Content-Type: {{contentType}}

{
  "name": "Café Étudiant Le Mâtin",
  "description": "Café convivial pour travailler en groupe ou faire une pause.",
  "category": "FOOD_SERVICE",
  "address": "5678 Boulevard René-Lévesque, Montréal"
}

### Il manque des champs obligatoires, ça doit échouer
POST {{baseUrl}}/places
Content-Type: {{contentType}}

{ "name": "Lieu Incomplet" }

### On envoie une catégorie invalide (pas dans l'enum)
POST {{baseUrl}}/places
Content-Type: {{contentType}}

{
  "name": "Salle de Sport",
  "description": "Gym du campus.",
  "category": "INVALID_CATEGORY",
  "address": "100 Rue des Sports"
}

### La description dépasse la limite de 300 caractères
POST {{baseUrl}}/places
Content-Type: {{contentType}}

{
  "name": "Lieu au texte trop long",
  "description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident.",
  "category": "STUDY_SPACE",
  "address": "200 Rue Exemple"
}

### Il y a un doublon dans 'services', ça doit échouer (@ArrayUnique)
POST {{baseUrl}}/places
Content-Type: {{contentType}}

{
  "name": "Labo Informatique",
  "description": "Postes de travail disponibles.",
  "category": "COMPUTER_LAB",
  "address": "Pavillon A, Local 300",
  "services": ["Wi-Fi", "Wi-Fi", "PC"]
}

### On récupère tous les lieux, pagination par défaut
GET {{baseUrl}}/places

### Pagination personnalisée
GET {{baseUrl}}/places?page=1&limit=2

### On filtre par catégorie
GET {{baseUrl}}/places?category=LIBRARY

### On filtre par catégorie et on pagine en même temps
GET {{baseUrl}}/places?category=FOOD_SERVICE&page=1&limit=5

### Pagination invalide : page < 1
GET {{baseUrl}}/places?page=0

### Pagination invalide : limit > 100
GET {{baseUrl}}/places?limit=150

### On va chercher un lieu existant par son ID
GET {{baseUrl}}/places/{{createdPlaceId}}

### Le lieu n'existe pas, on doit avoir un 404
GET {{baseUrl}}/places/plc_non_existant

### Mise à jour partielle d'un lieu
PATCH {{baseUrl}}/places/{{createdPlaceId}}
Content-Type: {{contentType}}

{
  "description": "Mise à jour : Fermeture exceptionnelle des salles de groupe.",
  "status": "TEMPORARILY_CLOSED"
}

### On envoie un statut invalide, ça doit échouer
PATCH {{baseUrl}}/places/{{createdPlaceId}}
Content-Type: {{contentType}}

{ "status": "STATUS_INVALIDE" }

### On essaie de mettre à jour un lieu qui n'existe pas (404)
PATCH {{baseUrl}}/places/plc_inexistant
Content-Type: {{contentType}}

{ "name": "Nouveau Nom" }

### On supprime le lieu créé plus haut (204 attendu)
DELETE {{baseUrl}}/places/{{createdPlaceId}}

### On essaie de supprimer un lieu qui n'existe pas (404)
DELETE {{baseUrl}}/places/plc_inexistant

### Verification finale : le lieu supprimé doit bien être introuvable (404)
GET {{baseUrl}}/places/{{createdPlaceId}}