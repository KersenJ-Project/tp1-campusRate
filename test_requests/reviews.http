@baseUrl = http://localhost:3000/api/v1
@contentType = application/json

### On a besoin d'un lieu pour pouvoir y accrocher des avis
# @name setupPlace
POST {{baseUrl}}/places
Content-Type: {{contentType}}

{
  "name": "Bibliothèque des Sciences",
  "description": "Un endroit calme pour étudier avec accès aux laboratoires.",
  "category": "LIBRARY",
  "address": "2000 Boulevard de l'Université",
  "services": ["Wi-Fi", "Silencieux"],
  "status": "ACTIVE"
}

###
@placeId = {{setupPlace.response.body.id}}

### Premier avis valide, note de 5
# @name createReview1
POST {{baseUrl}}/reviews?placeId={{placeId}}
Content-Type: {{contentType}}

{
  "authorName": "Jean Joseph",
  "comment": "Super endroit, très calme et propre.",
  "rating": 5
}

###
@reviewId1 = {{createReview1.response.body.id}}

### Deuxième avis valide, note de 3
# @name createReview2
POST {{baseUrl}}/reviews?placeId={{placeId}}
Content-Type: {{contentType}}

{
  "authorName": "Caleb Martin",
  "comment": "Un peu bruyant vers midi, mais correct dans l'ensemble.",
  "rating": 3
}

###
@reviewId2 = {{createReview2.response.body.id}}

### Pas de placeId fourni, ça doit échouer
POST {{baseUrl}}/reviews
Content-Type: {{contentType}}

{
  "authorName": "Charlie",
  "comment": "Commentaire orphelin",
  "rating": 4
}

### La note dépasse les limites (doit être entre 1 et 5)
POST {{baseUrl}}/reviews?placeId={{placeId}}
Content-Type: {{contentType}}

{
  "authorName": "David",
  "comment": "Hors limites",
  "rating": 10
}

### Il manque des champs obligatoires, ça doit échouer
POST {{baseUrl}}/reviews?placeId={{placeId}}
Content-Type: {{contentType}}

{ "authorName": "Eve" }

### On récupère tous les avis
GET {{baseUrl}}/reviews

### On filtre les avis par lieu (query param)
GET {{baseUrl}}/reviews?placeId={{placeId}}

### Même chose mais via la route dédiée
GET {{baseUrl}}/reviews/places/{{placeId}}

### On va chercher un avis existant par son ID
GET {{baseUrl}}/reviews/{{reviewId1}}

### L'avis n'existe pas, on doit avoir un 404
GET {{baseUrl}}/reviews/rev_inexistant

### Mise à jour de la note et du commentaire d'un avis
PATCH {{baseUrl}}/reviews/{{reviewId2}}
Content-Type: {{contentType}}

{
  "rating": 1,
  "comment": "Mise à jour : Très déçu lors de ma dernière visite, trop de bruit."
}

### On envoie une note invalide, ça doit échouer
PATCH {{baseUrl}}/reviews/{{reviewId1}}
Content-Type: {{contentType}}

{ "rating": -2 }

### On essaie de mettre à jour un avis qui n'existe pas (404)
PATCH {{baseUrl}}/reviews/rev_inexistant
Content-Type: {{contentType}}

{ "comment": "Test" }

### Petite vérif : les stats du lieu après création + modif des avis
# Attendu : reviewCount = 2, averageRating = 3.0 (moyenne entre 5 et 1)
GET {{baseUrl}}/places/{{placeId}}

### On supprime un avis
DELETE {{baseUrl}}/reviews/{{reviewId2}}

### Vérif que les stats se mettent à jour tout seules après suppression
# Attendu : reviewCount = 1, averageRating = 5.0
GET {{baseUrl}}/places/{{placeId}}

### On essaie de supprimer le lieu alors qu'il a encore un avis, ça doit échouer (409)
DELETE {{baseUrl}}/places/{{placeId}}

### On supprime le dernier avis du lieu
DELETE {{baseUrl}}/reviews/{{reviewId1}}

### Vérif finale du lieu, il ne doit plus avoir d'avis
# Attendu : reviewCount = 0, averageRating = null
GET {{baseUrl}}/places/{{placeId}}

### Le lieu n'a plus d'avis, on peut enfin le supprimer (204)
DELETE {{baseUrl}}/places/{{placeId}}

### On essaie de supprimer un avis qui n'existe pas (404)
DELETE {{baseUrl}}/reviews/rev_inexistant